# Basic app
PROJECT_NAME=
VERSION=
API_V1_STR=
CORS_ORIGINS=

# Security
APP_SECRET_KEY=
FERNET_KEY=

# MySQL (system metadata DB)
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DB=

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

# Text2SQL runtime
TEXT2SQL_ENABLED=
TEXT2SQL_MAX_ROWS=
TEXT2SQL_EXEC_TIMEOUT_SECONDS=20
TEXT2SQL_AUTO_REPAIR_ROUNDS=
TEXT2SQL_SELF_CONSISTENCY_N=
TEXT2SQL_SELF_CONSISTENCY_TEMPERATURE=
TEXT2SQL_MULTI_TABLE_ENABLED=
TEXT2SQL_MAX_JOIN_TABLES=
TEXT2SQL_QUERY_LOG_ENABLED=
# 结果行默认禁止写入应用日志；仅在短期受控排障时显式开启。
TEXT2SQL_LOG_RESULT_ROWS_ENABLED=false
TEXT2SQL_QUERY_LOG_RETENTION_DAYS=30
TEXT2SQL_QUERY_LOG_CLEANUP_INTERVAL_SECONDS=86400
TEXT2SQL_QUERY_LOG_CLEANUP_BATCH_SIZE=1000
TEXT2SQL_FEW_SHOT_ENABLED=
TEXT2SQL_FEWSHOT_MIN_SCORE=
# 高置信命中已审核样例时直接复用 SQL；未达到阈值时仍作为 Prompt 示例使用。
TEXT2SQL_FEWSHOT_DIRECT_REUSE_ENABLED=true
TEXT2SQL_FEWSHOT_DIRECT_REUSE_MIN_SCORE=0.97
TEXT2SQL_FEWSHOT_DIRECT_REUSE_MIN_MARGIN=0.03
TEXT2SQL_FEWSHOT_DIRECT_REUSE_MIN_LEXICAL_SIMILARITY=0.90
# 启用 Few-shot 时必须显式指定已有知识库 ID；留空或 0 不启用知识库回流与召回。
FEW_SHOT_KB_ID=
DATA_DICTIONARY_KB_ID=
TEXT2SQL_SCHEMA_PRUNE_ENABLED=
TEXT2SQL_SCHEMA_MAX_COLS_PER_TABLE=
TEXT2SQL_SCHEMA_PRUNE_KEEP_COLS=
TEXT2SQL_ENUM_HINT_ENABLED=false
# 仅允许精确的 table.column，不支持通配符；例如 ["student_public.status","course_public.level"]
TEXT2SQL_ENUM_HINT_ALLOWLIST=[]
TEXT2SQL_ENUM_HINT_SAMPLE_ROWS=
TEXT2SQL_ENUM_HINT_TOP_VALUES=
TEXT2SQL_ENUM_HINT_MAX_COLUMNS_PER_TABLE=
TEXT2SQL_ENUM_HINT_MAX_WORKERS=
TEXT2SQL_ENUM_HINT_PROBE_TIMEOUT_MS=
TEXT2SQL_ENUM_HINT_MAX_PROMPT_CHARS=
TEXT2SQL_ENUM_HINT_MAX_TABLES=
# true 时，连接测试/保存/运行均拒绝可写账号、基础表读取和跨 Schema 视图读取。
TEXT2SQL_REQUIRE_READONLY_VIEWS=true
# Text2SQL 与 Document QA 共用固定线程池和并发配额；队列满或客户端断开会触发协作式取消。
SSE_MAX_CONCURRENT_STREAMS=8
SSE_MAX_STREAMS_PER_USER=2
SSE_EVENT_QUEUE_SIZE=32
SSE_EVENT_ENQUEUE_TIMEOUT_SECONDS=0.25
SSE_DISCONNECT_POLL_SECONDS=0.25
SSE_WORKER_CANCEL_WAIT_SECONDS=1.0
# Redis 故障时默认拒绝昂贵请求，避免多 Worker 限额失效。
RESOURCE_LIMIT_REDIS_FAIL_OPEN=false
RESOURCE_LEASE_TTL_SECONDS=3600
QA_RATE_LIMIT_ENABLED=true
QA_RATE_LIMIT_PER_USER_PER_MINUTE=20
QA_RATE_LIMIT_GLOBAL_PER_MINUTE=200
QA_COST_BUDGET_PER_USER_PER_DAY=200
TEXT2SQL_QUERY_COST_UNITS=5
DOCUMENT_QA_QUERY_COST_UNITS=3
TABLE_QA_QUERY_COST_UNITS=3
# 码值字典：编码注入（生成前，让模型用真实 code 过滤）与解码替换（查询后，把 code 换成中文）
TEXT2SQL_CODE_HINT_ENABLED=
TEXT2SQL_CODE_HINT_SMALL_DICT_MAX=
TEXT2SQL_CODE_HINT_MAX_VALUES_PER_CATEGORY=
TEXT2SQL_CODE_DECODE_ENABLED=
TEXT2SQL_CODE_DECODE_MAX_ROWS=

# Table routing：必须显式指定已有表路由知识库 ID；留空或 0 时使用非向量路由。
TABLE_ROUTE_KB_ID=
TABLE_ROUTE_KB_SEARCH_TOP_K=
TABLE_ROUTE_KB_RECALL_CANDIDATES=
TABLE_ROUTE_MAX_CANDIDATES=
TABLE_ROUTE_AMBIGUITY_DELTA=
TABLE_ROUTE_SEMANTIC_SCORE_WEIGHT=
TABLE_ROUTE_KEYWORD_SCORE_WEIGHT=
TABLE_ROUTE_PROFILE_SCORE_WEIGHT=
TABLE_ROUTE_NAME_EXACT_MATCH_SCORE=
TABLE_ROUTE_NAME_TOKEN_MATCH_SCORE=
TABLE_ROUTE_PROFILE_TOKEN_MATCH_SCORE=
TABLE_ROUTE_PROFILE_SCORE_CAP=

# Model providers are stored in the system database through /api/v1/text2sql/model-config.
# MinIO
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=
MINIO_BUCKET_NAME=

# Elasticsearch
ES_URL=
ES_HOST=
ES_PORT=
ES_INDEX_NAME=
# Fallback vector dimension used only when no embedding model config is active.
ES_VECTOR_DIM=
ES_REQUEST_TIMEOUT_SECONDS=
ES_KNN_NUM_CANDIDATES=
STARTUP_WAIT_ES=

# Knowledge base async tasks
KB_ENABLED=
KB_ASYNC_ENABLED=
KB_ASYNC_BACKEND=
KB_QUEUE_NAME=
KB_TASK_TIMEOUT_SECONDS=
KB_TASK_SOFT_TIMEOUT_SECONDS=1680
KB_TASK_MAX_RETRIES=3
KB_TASK_RETRY_BACKOFF_SECONDS=15
KB_TASK_RETRY_BACKOFF_MAX_SECONDS=300
# 必须大于硬超时；巡检会将长期停留在排队/处理中状态的任务置为失败并使旧消息失效。
KB_TASK_STALE_AFTER_SECONDS=2100
KB_TASK_RECONCILE_INTERVAL_SECONDS=300
KB_TASK_RECONCILE_BATCH_SIZE=100
# Redis visibility timeout 必须大于单次任务硬超时，避免任务尚未结束就被重复投递。
CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
KB_CHUNK_SIZE=
KB_CHUNK_OVERLAP=
MAX_UPLOAD_FILE_SIZE_MB=
MAX_UPLOAD_FILES_PER_REQUEST=10
MAX_TOTAL_UPLOAD_SIZE_MB=100
CODE_DICT_MAX_UPLOAD_FILE_SIZE_MB=10
CODE_DICT_MAX_FILES_PER_REQUEST=10
CODE_DICT_MAX_TOTAL_UPLOAD_SIZE_MB=30
ALLOWED_FILE_TYPES=["txt","md","markdown","docx","pdf","pptx","html","htm","rtf","csv","json","yaml","yml","sql","log"]
KB_USAGE_STRICT_ES_FILTER=true
KB_USAGE_AUDIT_LOG_ENABLED=true
DATA_DICTIONARY_FEATURE_ENABLED=false

# Complex table parsing thresholds
LARGE_TABLE_CELL_THRESHOLD=800
LARGE_TABLE_ROW_THRESHOLD=80
LARGE_TABLE_COLUMN_THRESHOLD=30
LARGE_TABLE_MERGED_CELL_THRESHOLD=20
LARGE_TABLE_MARKDOWN_THRESHOLD=30000

# Celery
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=

# Startup wait
STARTUP_WAIT_ENABLED=
STARTUP_WAIT_INTERVAL_SECONDS=
STARTUP_WAIT_TIMEOUT_SECONDS=
STARTUP_WAIT_MINIO=

ENVIRONMENT=development

BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
OAUTH_LOGOUT_REDIRECT_URI=http://localhost:8000/api/v1/auth/logout/callback

SESSION_COOKIE_NAME=t2s_session
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false

# 仅在本地需要测试登录时开启；生产环境必须保持 false。
ENABLE_DEV_LOGIN=true

BOOTSTRAP_ADMIN_UNICODES=[]
